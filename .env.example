# Adresse du backend SportSee (projet P6JS fourni par OpenClassrooms).
# Copier ce fichier en .env.local avant de lancer l'application :
#   cp .env.example .env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clé API Mistral, disponible uniquement côté serveur.
MISTRAL_API_KEY=
# Facultatif : le modèle utilisé par la route /api/chat.
MISTRAL_MODEL=mistral-small-latest
